\bibcite{thompson2015}{{1}{2015}{{Thompson et~al.}}{{}}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Zero-point energy by loss function.} Mean absolute error (MAE) of the reactant zero-point energy (ZPE) and of the reaction $\Delta $ZPE relative to density-functional theory (DFT) for HIP-EquiformerV2 trained with mean squared error (MSE), mean absolute error (MAE) or MAE plus subspace loss (MAE+Sub). Values in parentheses are sample standard deviations of the signed errors $\mathrm  {ZPE}_{\mathrm  {model}}-\mathrm  {ZPE}_{\mathrm  {DFT}}$ and $\Delta \mathrm  {ZPE}_{\mathrm  {model}}-\Delta \mathrm  {ZPE}_{\mathrm  {DFT}}$. Bold values mark the best result in each column. Energies are in eV per molecule. $n=47$ reactant--product pairs. No inferential statistical test was applied.}}{11}{table.2}\protected@file@percent }
\newlabel{tab:loss_zpe}{{2}{11}{\textbf {Zero-point energy by loss function.} Mean absolute error (MAE) of the reactant zero-point energy (ZPE) and of the reaction $\Delta $ZPE relative to density-functional theory (DFT) for HIP-EquiformerV2 trained with mean squared error (MSE), mean absolute error (MAE) or MAE plus subspace loss (MAE+Sub). Values in parentheses are sample standard deviations of the signed errors $\mathrm {ZPE}_{\mathrm {model}}-\mathrm {ZPE}_{\mathrm {DFT}}$ and $\Delta \mathrm {ZPE}_{\mathrm {model}}-\Delta \mathrm {ZPE}_{\mathrm {DFT}}$. Bold values mark the best result in each column. Energies are in eV per molecule. $n=47$ reactant--product pairs. No inferential statistical test was applied}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Transition-state search by loss function.} Counts of ReactBench reactions that pass transition-state (TS) success, restricted-step partitioned rational-function optimization (RFO) convergence, or both, for HIP-EquiformerV2 trained with mean squared error (MSE), mean absolute error (MAE) or MAE plus subspace loss (MAE+Sub). Bold values mark the best result in each column. $n=960$ reactions. No inferential statistical test was applied.}}{11}{table.3}\protected@file@percent }
\newlabel{tab:loss_tssearch}{{3}{11}{\textbf {Transition-state search by loss function.} Counts of ReactBench reactions that pass transition-state (TS) success, restricted-step partitioned rational-function optimization (RFO) convergence, or both, for HIP-EquiformerV2 trained with mean squared error (MSE), mean absolute error (MAE) or MAE plus subspace loss (MAE+Sub). Bold values mark the best result in each column. $n=960$ reactions. No inferential statistical test was applied}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Frequency-analysis classification by loss function.} True-positive rate (TPR), false-positive rate (FPR), false-negative rate (FNR), true-negative rate (TNR), precision and accuracy for identifying first-order transition states from the number of negative Hessian eigenvalues. Accuracy All is the accuracy for classifying any stationary-point type (minimum, first-order saddle or higher-order saddle). HIP-EquiformerV2 was trained with mean squared error (MSE), mean absolute error (MAE) or MAE plus subspace loss (MAE+Sub). Bold values mark the best result in each column. $n=1000$ HORM-T1x validation geometries. No inferential statistical test was applied.}}{11}{table.4}\protected@file@percent }
\newlabel{tab:loss_freqanalysis}{{4}{11}{\textbf {Frequency-analysis classification by loss function.} True-positive rate (TPR), false-positive rate (FPR), false-negative rate (FNR), true-negative rate (TNR), precision and accuracy for identifying first-order transition states from the number of negative Hessian eigenvalues. Accuracy All is the accuracy for classifying any stationary-point type (minimum, first-order saddle or higher-order saddle). HIP-EquiformerV2 was trained with mean squared error (MSE), mean absolute error (MAE) or MAE plus subspace loss (MAE+Sub). Bold values mark the best result in each column. $n=1000$ HORM-T1x validation geometries. No inferential statistical test was applied}{table.4}{}}
