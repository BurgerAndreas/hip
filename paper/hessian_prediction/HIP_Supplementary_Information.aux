\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Loss-function accuracy.} Mean absolute errors and cosine similarities for HIP-EquiformerV2 trained with mean squared error (MSE), mean absolute error (MAE) or MAE plus subspace loss (MAE+Sub). Hessian, eigenvalue and $\lambda _1$, $\lambda _2$ columns are in eV/\r A$^2$. Superscript $E$ denotes quantities after Eckart projection of the mass-weighted Hessian. Bold values mark the best result in each column. $n=1000$ HORM-T1x validation geometries. No inferential statistical test was applied.}}{10}{table.1}\protected@file@percent }
\newlabel{tab:loss_acc}{{1}{10}{\textbf {Loss-function accuracy.} Mean absolute errors and cosine similarities for HIP-EquiformerV2 trained with mean squared error (MSE), mean absolute error (MAE) or MAE plus subspace loss (MAE+Sub). Hessian, eigenvalue and $\lambda _1$, $\lambda _2$ columns are in eV/\AA $^2$. Superscript $E$ denotes quantities after Eckart projection of the mass-weighted Hessian. Bold values mark the best result in each column. $n=1000$ HORM-T1x validation geometries. No inferential statistical test was applied}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Geometry relaxation by loss function.} Rational-function optimization (RFO) with HIP-EquiformerV2 Hessians trained using mean squared error (MSE), mean absolute error (MAE) or MAE plus subspace loss (MAE+Sub). \textbf  {(a)} Steps to convergence. \textbf  {(b)} Wall-clock time. Violins show the sample distribution and overlaid points are individual geometries. $n=80$ Transition1x validation reactant geometries. No inferential statistical test was applied.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:loss_relax}{{2}{10}{\textbf {Geometry relaxation by loss function.} Rational-function optimization (RFO) with HIP-EquiformerV2 Hessians trained using mean squared error (MSE), mean absolute error (MAE) or MAE plus subspace loss (MAE+Sub). \textbf {(a)} Steps to convergence. \textbf {(b)} Wall-clock time. Violins show the sample distribution and overlaid points are individual geometries. $n=80$ Transition1x validation reactant geometries. No inferential statistical test was applied}{figure.2}{}}
