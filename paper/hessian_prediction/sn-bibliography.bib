  langid = {english},
  keywords = {Cheminformatics,Quantum chemistry,Reaction kinetics and dynamics},
  file = {/home/andreas/Zotero/storage/S5DWW8KC/Grambow et al. - 2020 - Reactants, products, and transition states of elementary chemical reactions based on quantum chemist.pdf}
}

