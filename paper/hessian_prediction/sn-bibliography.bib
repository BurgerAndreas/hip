@article{westermayr2023,
  title = {High-Throughput Property-Driven Generative Design of Functional Organic Molecules},
  author = {Westermayr, Julia and Gilkes, Joe and Barrett, Rhyan and Maurer, Reinhard J.},
  year = 2023,
  month = feb,
  journal = {Nature Computational Science},
  volume = {3},
